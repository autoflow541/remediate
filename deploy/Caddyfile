# Caddy reverse proxy for pdf.auto-flow.co — matches /etc/caddy/Caddyfile on the VM.
#
# Routing rule: all non-GET requests go to the FastAPI engine (the SPA only
# serves GETs), so NEW POST ENDPOINTS NEVER NEED A CADDYFILE EDIT. Only the
# GET-able API paths are listed explicitly.
#
# Reload after edits: sudo systemctl reload caddy

pdf.auto-flow.co {
    # GET API routes -> FastAPI engine
    # /jobs/* covers the async job queue's poll/download endpoints (GET
    # /jobs/{id}, /jobs/{id}/result, /jobs/{id}/report) -- these are GET, so
    # the "non-GET = API" rule below never covers them; without this they
    # silently fall through to the SPA and return index.html instead of JSON.
    @apiGet path /health /health/* /docs /docs/* /redoc /redoc/* /openapi.json /jobs/*
    handle @apiGet {
        reverse_proxy localhost:8000
    }

    # All non-GET requests are API calls -> engine
    @apiWrite method POST PUT DELETE PATCH
    handle @apiWrite {
        reverse_proxy localhost:8000
    }

    # Everything else -> React SPA
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
